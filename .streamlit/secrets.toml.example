# Copy this into Streamlit Community Cloud under "Advanced settings -> Secrets",
# or save it locally as .streamlit/secrets.toml (never commit the real file).
#
# One GitHub token covers every page; each tool has its own queue folders in the
# operational_tools repository, and its own users.

# ---------------------------------------------------------------------------
# Logins
# ---------------------------------------------------------------------------
# A name directly under [auth] is an ADMINISTRATOR: it reaches every page.
# A name under [auth.<app>] reaches that one page only, so the same username
# can exist for several apps with a different password each.
#
# Generate every line with:
#     python tools/make_password_hash.py Wadih
#     python tools/make_password_hash.py backoffice kibo

[auth]
Wadih = "pbkdf2_sha256$260000$0123456789abcdef0123456789abcdef$replace-me"

[auth.kibo]
backoffice = "pbkdf2_sha256$260000$11111111111111111111111111111111$replace-me"

[auth.warehouse]
backoffice = "pbkdf2_sha256$260000$22222222222222222222222222222222$replace-me"

[auth.ledger]
backoffice = "pbkdf2_sha256$260000$33333333333333333333333333333333$replace-me"

# ---------------------------------------------------------------------------
# Staging pages
# ---------------------------------------------------------------------------
# Who may open a staging page — the working copy of a live page, where a change
# to a flow is tried before the users' version carries it.
#
# This list is the ONLY way in. Being an administrator is deliberately not
# enough: an administrator who is not named here does not see the page in the
# sidebar and is refused if they reach it by its URL. There is no [auth.<app>]
# section for a staging page and granting its key would do nothing.
#
# Leave this section out entirely and the default below applies.

[staging]
users = ["Wadih"]

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------
[github]
# A fine-grained personal access token scoped to the operational_tools
# repository with Contents: Read and write.
token  = "github_pat_..."
repo   = "your-org/operational_tools"
branch = "main"

# Queue folders. The defaults in the code already match the repository layout,
# so these two sections are only needed if you move a queue.

[kibo]
input_dir   = "input"
logs_dir    = "logs"
archive_dir = "archive"
error_dir   = "error"

[warehouse]
input_dir   = "warehouse/input"
logs_dir    = "warehouse/logs"
archive_dir = "warehouse/archive"
error_dir   = "warehouse/error"

# The staging copy of the warehouse page. With no section at all it follows the
# live page exactly — same repo, same branch, same folders — so a submission
# there is a real cancellation through the production workflow. Uncomment to
# point it somewhere else; anything left out falls back to the live value.

# [warehouse_staging]
# branch      = "staging"
# input_dir   = "warehouse/staging/input"
# logs_dir    = "warehouse/staging/logs"
# archive_dir = "warehouse/staging/archive"
# error_dir   = "warehouse/staging/error"

# ---------------------------------------------------------------------------
# BigQuery — the Cancellation ledger page only
# ---------------------------------------------------------------------------
# A service account that can READ
# `tlg-business-intelligence-prd`.til.warehouse_orders_cancellation_table.
# roles/bigquery.dataViewer on the dataset and roles/bigquery.jobUser on the
# project is enough. Give it no write role: the page only ever reads, and a
# read-only account means a mistake here can never alter the ledger.
#
# Paste the service-account JSON field by field. Keep the private key on one
# line with its \n escapes exactly as the JSON file has them.

[bigquery]
type                        = "service_account"
project_id                  = "tlg-business-intelligence-prd"
private_key_id              = "..."
private_key                 = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email                = "ledger-reader@tlg-business-intelligence-prd.iam.gserviceaccount.com"
client_id                   = "..."
auth_uri                    = "https://accounts.google.com/o/oauth2/auth"
token_uri                   = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url        = "..."
