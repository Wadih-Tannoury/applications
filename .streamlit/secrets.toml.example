# Copy this into Streamlit Community Cloud under "Advanced settings -> Secrets",
# or save it locally as .streamlit/secrets.toml (never commit the real file).
#
# One GitHub token covers every page; each tool has its own queue folders in the
# operational_tools repository, and its own users.

# ---------------------------------------------------------------------------
# Logins
# ---------------------------------------------------------------------------
# A name directly under [auth] is an ADMINISTRATOR: it reaches every page.
# A name under [auth.<app>] reaches that one page only, so the same username
# can exist for several apps with a different password each.
#
# Generate every line with:
#     python tools/make_password_hash.py Wadih
#     python tools/make_password_hash.py backoffice kibo

[auth]
Wadih = "pbkdf2_sha256$260000$0123456789abcdef0123456789abcdef$replace-me"

[auth.kibo]
backoffice = "pbkdf2_sha256$260000$11111111111111111111111111111111$replace-me"

[auth.warehouse]
backoffice = "pbkdf2_sha256$260000$22222222222222222222222222222222$replace-me"

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------
[github]
# A fine-grained personal access token scoped to the operational_tools
# repository with Contents: Read and write.
token  = "github_pat_..."
repo   = "your-org/operational_tools"
branch = "main"

# Queue folders. The defaults in the code already match the repository layout,
# so these two sections are only needed if you move a queue.

[kibo]
input_dir   = "input"
logs_dir    = "logs"
archive_dir = "archive"
error_dir   = "error"

[warehouse]
input_dir   = "warehouse/input"
logs_dir    = "warehouse/logs"
archive_dir = "warehouse/archive"
error_dir   = "warehouse/error"
